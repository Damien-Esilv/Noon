    "Sur les écrans Apple Pro Display XDR ou Liquid Retina XDR, les préréglages studio verrouillent matériellement le point blanc et la courbe gamma.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les écrans Apple Pro Display XDR ou Liquid Retina XDR, les préréglages studio verrouillent matériellement le point blanc et la courbe gamma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Apple Pro Display XDR or Liquid Retina XDR displays, studio presets lock white point and gamma in hardware."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sui display Apple Pro Display XDR o Liquid Retina XDR, i preset studio bloccano a livello hardware punto di bianco e curva gamma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Apple Pro Display XDR oder Liquid Retina XDR sperren die Studio-Voreinstellungen Weißpunkt und Gammakurve hardwareseitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pantallas Apple Pro Display XDR o Liquid Retina XDR, los preajustes de estudio bloquean por hardware el punto blanco y la curva gamma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas telas Apple Pro Display XDR ou Liquid Retina XDR, as predefinições de estúdio bloqueiam por hardware o ponto de branco e a curva gama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Pro Display XDR 或 Liquid Retina XDR 显示屏上，工作室预设会在硬件层面锁定白点和伽马曲线。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على شاشات Apple Pro Display XDR أو Liquid Retina XDR، تقفل الإعدادات المسبقة للاستوديو نقطة البياض ومنحنى جاما عتادياً."
          }
        }
      }
    }
  },
