    "Activer les notifications" : {
      "comment" : "A toggle that enables or disables notifications.",
      "isCommentAutoGenerated" : true
    },
    "Activez ou désactivez la gestion des couleurs et de la calibration pour chaque écran." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتفعيل أو تعطيل إدارة الألوان والمعايرة لكل شاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren oder deaktivieren Sie Farbmanagement und Kalibrierung für jeden Bildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable or disable color management and calibration for each display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active o desactive la gestión del color y la calibración para cada pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ou désactivez la gestion des couleurs et de la calibration pour chaque écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva la gestione del colore e della calibrazione per ciascuno schermo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative o gerenciamento de cores e calibração para cada tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个显示屏启用或禁用颜色管理与校准。"
          }
        }
      }
    },
    "Affiche brièvement une bannière sous l'encoche confirmant le profil de fidélité et la calibration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض لفترة وجيزة شريطاً أسفل النتوء لتأكيد ملف دقة الألوان والمعايرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt kurz ein Banner unter der Notch an, um das Profil und die Kalibrierung zu bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefly displays a banner under the notch confirming the fidelity profile and calibration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra brevemente un cartel bajo la muesca confirmando el perfil de fidelidad y la calibración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche brièvement une bannière sous l'encoche confirmant le profil de fidélité et la calibration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra brevemente un banner sotto la tacca confermando il profilo di fedeltà e la calibrazione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra brevemente um banner sob o entalhe confirmando o perfil de fidelidade e calibração."
