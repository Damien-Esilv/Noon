    "Attend que toutes les apps créatives soient complètement fermées avant de réactiver.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر حتى يتم إغلاق جميع التطبيقات الإبداعية بالكامل قبل إعادة التفعيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis alle kreativen Apps vollständig beendet sind, bevor die Reaktivierung erfolgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits until all creative apps are fully closed before reactivating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que todas las apps creativas estén completamente cerradas antes de reactivar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend que toutes les apps créatives soient complètement fermées avant de réactiver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attende che tutte le app creative siano completamente chiuse prima di riattivare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarda que todos os apps criativos sejam completamente fechados antes de reativar."
          }
        },
