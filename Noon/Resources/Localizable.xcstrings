            "value": "Applique automatiquement votre profil d'écran étalonné dès qu'une application ou un site surveillé est actif."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically applies your calibrated display profile as soon as a monitored app or website is active."
          }
        },
        "it": {
