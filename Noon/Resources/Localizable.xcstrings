    "Les profils créés avec des sondes tierces (Calibrite, Spyder, etc.) ou l'assistant macOS sont automatiquement pris en charge.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils créés avec des sondes tierces (Calibrite, Spyder, etc.) ou l'assistant macOS sont automatiquement pris en charge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles created with third-party probes (Calibrite, Spyder, etc.) or macOS Assistant are automatically supported."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili creati con sonde di terze parti (Calibrite, Spyder, ecc.) o l'assistente macOS sono supportati automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, die mit Drittanbieter-Sensoren (Calibrite, Spyder usw.) oder dem macOS-Assistenten erstellt wurden, werden automatisch unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles creados con sondas de terceros (Calibrite, Spyder, etc.) o el Asistente de macOS son compatibles automáticamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis criados com sondas de terceiros (Calibrite, Spyder, etc.) ou o Assistente do macOS são suportados automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动支持通过第三方校色仪（Calibrite、Spyder等）或 macOS 助理创建的描述文件。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم دعم ملفات التعريف المنشأة بواسطة مجسات خارجية (Calibrite وSpyder وما إلى ذلك) أو مساعد macOS تلقائياً."
          }
        }
      }
    },
