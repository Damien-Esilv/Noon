          }
        }
      }
    },
    "Applique automatiquement votre profil d'écran étalonné dès qu'une application ou un site surveillé est actif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطبق ملف تعريف العرض المعاير تلقائياً بمجرد نشاط تطبيق أو موقع ويب خاضع للمراقبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wendet Ihr kalibriertes Anzeigeprofil automatisch an, sobald eine überwachte App oder Website aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically applies your calibrated display profile as soon as a monitored app or website is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica automáticamente tu perfil de pantalla calibrado tan pronto como una app o sitio web monitoreado esté activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applique automatiquement votre profil d'écran étalonné dès qu'une application ou un site surveillé est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica automaticamente il profilo display calibrato non appena un'app o un sito monitorato è attivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica automaticamente seu perfil de tela calibrado assim que um app ou site monitorado estiver ativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当受监控的应用程序或网站处于活动状态时，自动应用校准的显示描述文件。"
          }
        }
      }
    },
    "Apps créatives courantes détectées sur votre Mac" : {
      "localizations" : {
