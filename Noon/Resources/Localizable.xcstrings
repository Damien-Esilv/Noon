    "Applique 100 nits sur écrans XDR (standard studio SDR) ou 50% sur écrans Retina standards." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبق 100 شمعة على شاشات XDR (معيار الاستوديو SDR) أو 50% على شاشات Retina القياسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wendet 100 Nits auf XDR-Displays an (SDR-Studio-Standard) oder 50 % auf Standard-Retina-Displays."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies 100 nits on XDR displays (SDR studio standard) or 50% on standard Retina displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica 100 nits en pantallas XDR (estándar de estudio SDR) o 50% en pantallas Retina estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
