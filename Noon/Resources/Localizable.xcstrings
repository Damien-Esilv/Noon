    "Active automatiquement le mode créatif lors de l'utilisation d'onglets de design dans Safari, Chrome, Arc ou Edge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically activates creative mode when design tabs are used in Safari, Chrome, Arc, or Edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active automatiquement le mode créatif lors de l'utilisation d'onglets de design dans Safari, Chrome, Arc ou Edge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva automaticamente la modalità creativa quando si utilizzano schede di design in Safari, Chrome, Arc o Edge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert den Kreativmodus automatisch bei Design-Tabs in Safari, Chrome, Arc oder Edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa automáticamente el modo creativo al utilizar pestañas de diseño en Safari, Chrome, Arc o Edge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa automaticamente o modo criativo ao usar abas de design no Safari, Chrome, Arc ou Edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari、Chrome、Arc 或 Edge 中使用设计标签页时自动激活创作模式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل الوضع الإبداعي تلقائياً عند استخدام علامات تبويب التصميم في Safari أو Chrome أو Arc أو Edge."
          }
        }
      }
    },
    "Activez ou désactivez la gestion des couleurs et de la calibration pour chaque écran.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable or disable color management and calibration for each display."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez la gestion des couleurs et de la calibration pour chaque écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva la gestione del colore e della calibrazione per ciascuno schermo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren oder deaktivieren Sie Farbmanagement und Kalibrierung für jeden Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active o desactive la gestión del color y la calibración para cada pantalla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative ou desative o gerenciamento de cores e calibração para cada tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个显示屏启用或禁用颜色管理与校准。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتفعيل أو تعطيل إدارة الألوان والمعايرة لكل شاشة."
          }
        }
      }
    },
    "Affiche brièvement une bannière sous l'encoche confirmant le profil de fidélité et la calibration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly displays a banner under the notch confirming the fidelity profile and calibration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche brièvement une bannière sous l'encoche confirmant le profil de fidélité et la calibration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevemente un banner sotto la tacca confermando il profilo di fedeltà e la calibrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt kurz ein Banner unter der Notch an, um das Profil und die Kalibrierung zu bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra brevemente un cartel bajo la muesca confirmando el perfil de fidelidad y la calibración."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevemente um banner sob o entalhe confirmando o perfil de fidelidade e calibração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海下方短暂显示横幅，确认色彩保真度配置文件和校准状态。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض لفترة وجيزة شريطاً أسفل النتوء لتأكيد ملف دقة الألوان والمعايرة."
          }
        }
      }
    },
    "Affiche le temps restant à côté de l'icône": {
      "localizations": {
